{
  "name": "candidlens",
  "version": "1.5.0",
  "private": false,
  "description": "Command-line companion for CandidLens: create jobs, draft rubrics, upload resumes and score candidates from any pipeline.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "candidlens": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhay-yemekar/candidlens.git",
    "directory": "apps/cli"
  },
  "keywords": [
    "hiring",
    "recruiting",
    "ats",
    "resume-screening",
    "ai",
    "llm",
    "cli"
  ],
  "homepage": "https://candidlens.vercel.app/docs/cli",
  "bugs": "https://github.com/abhay-yemekar/candidlens/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@candidlens/config": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
